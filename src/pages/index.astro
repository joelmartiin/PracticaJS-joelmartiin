---
import Layout from "../layouts/Layout.astro"
import Registro from "../components/Registro.astro"
import Juego from "../components/Juego.astro"
---

<Layout>
    <div id="vista-registro" hidden>
        <Registro />
    </div>
    <div id="vista-juego" hidden>
        <Juego />
    </div>
</Layout>

<script>
    const logueado = sessionStorage.getItem("user")
    const registro = document.getElementById("vista-registro")
    const juego = document.getElementById("vista-juego")

    if (registro) registro.hidden = !!logueado
    if (juego) juego.hidden = !logueado
</script>