---
import Registro from '../components/Registro.astro';
import Layout from '../layouts/Layout.astro';
import Juego from '../components/Juego.astro'
---

<Layout>
	<div id="vista-registro">
		<Registro />
	</div>

	<div id="vista-juego" hidden>
		<Juego />
	</div>
	
	<script>
		const form = document.getElementById('formulario-registro') as HTMLFormElement;
		const vistaRegistro = document.getElementById('vista-registro')!;
		const vistaJuego = document.getElementById('vista-juego')!;

		form.addEventListener('submit', (e) => {
			e.preventDefault();

			const nombre = (document.getElementById('username') as HTMLInputElement).value;

			vistaRegistro.hidden = true;
			vistaJuego.hidden = false;

			window.dispatchEvent(new CustomEvent('iniciar-juego', { detail: { nombre } }));
		});
	</script>
</Layout>
