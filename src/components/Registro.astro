        background: white;
        width: 100%;
        max-width: 420px;
        padding: 40px;
        border-radius: 25px;
        border: 4px solid #31558c;
        box-shadow: 0 9px 0 #31558c;
        display: flex;
        flex-direction: column;
        gap: 12px;
        font-weight: 800;
        font-size: 17px;
    }

    #formulario-registro::before {
        content: "⚡ POKÉMEMORY ⚡";
        display: block;
        text-align: center;
        font-size: 28px;
        font-weight: 900;
        color: #e63946;
        margin-bottom: 15px;
    }

    #formulario-registro input {
        width: 100%;
        padding: 13px;
        border: 2px solid #b8cde5;
        border-radius: 12px;
        outline: none;
        font-size: 16px;
        background: #f5faff;
    }

    #formulario-registro input:focus {
        border-color: #f5c518;
        box-shadow: 0 0 0 3px #f5c51855;
    }

    #boton-registro {
        margin-top: 15px;
        padding: 14px;
        border-radius: 12px;
        background: #f5c518;
        color: #26344a;
        font-size: 17px;
        box-shadow: 0 5px 0 #c59c00;
    }

    #boton-registro:active {
        transform: translateY(4px);
        box-shadow: 0 1px 0 #c59c00;
    }

    #mensaje {
        font-weight: 800;
        color: #31558c;
    }
</style>