---
import Ranking from "./Ranking.astro"
---

<div id="game">
    <section class="left">
        <h1>Bienvenido al juego</h1>
        <form id="game-form">
            Número de cartas (par)
            <input type="number" id="cards-number" />
            <button type="submit" id="play-btn">Jugar</button>
        </form>

        <dialog id="modal">
            <p id="modal-text"></p>
            <button type="button" id="modal-close">Cerrar</button>
        </dialog>

        <p id="timer"></p>
        <p id="result"></p>
        <div id="game-board" hidden></div>
    </section>

    <Ranking />

    <button type="button" id="logout-btn">Cerrar sesión</button>
</div>

<script>
    const form = document.getElementById("game-form") as HTMLFormElement | null
    const input = document.getElementById("cards-number") as HTMLInputElement | null
    const modal = document.getElementById("modal") as HTMLDialogElement | null
    const modalText = document.getElementById("modal-text") as HTMLParagraphElement | null
    const modalClose = document.getElementById("modal-close") as HTMLButtonElement | null
    const result = document.getElementById("result") as HTMLParagraphElement | null
    const playBtn = document.getElementById("play-btn") as HTMLButtonElement | null
    const timer = document.getElementById("timer") as HTMLParagraphElement | null
    const board = document.getElementById("game-board") as HTMLDivElement | null
    const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement | null

    const MAX_POKEMON = 151
    let intervalId: number | undefined
    let seconds = 0
    let firstCard: HTMLElement | null = null
    let lock = false
    let matchedPairs = 0
    let totalPairs = 0
    let gameId = 0
    const sprites = new Map<number, string>()

    function showError(message: string) {
        if (!modal || !modalText) return
        modalText.textContent = message
        modal.showModal()
    }

    function startTimer() {
        if (!timer) return
        clearInterval(intervalId)
        seconds = 0
        timer.textContent = "0m 0s"

        intervalId = window.setInterval(() => {
            seconds++
            timer.textContent = `${Math.floor(seconds / 60)}m ${seconds % 60}s`
        }, 1000)
    }

    function mezclar<T>(arr: T[]): T[] {
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1))
            ;[arr[i], arr[j]] = [arr[j], arr[i]]
        }
        return arr
    }

    async function getSprite(id: number): Promise<string> {
        const res = await fetch(`https://pokeapi.co/api/v2/pokemon/${id}`)
        const data = await res.json()
        return data.sprites.front_default
    }

    async function buildBoard(n: number): Promise<boolean> {
        if (!board) return false
        const currentGame = ++gameId

        board.innerHTML = ""
        firstCard = null
        lock = true
        matchedPairs = 0
        totalPairs = n / 2
        if (result) result.textContent = ""

        const pool = mezclar(Array.from({ length: MAX_POKEMON }, (_, i) => i + 1))
        const ids = pool.slice(0, n / 2)

        try {
            await Promise.all(
                ids.map(async (id) => {
                    if (!sprites.has(id)) sprites.set(id, await getSprite(id))
                })
            )
        } catch {
            showError("Error cargando los pokemon")
            return false
        }

        if (currentGame !== gameId) return false

        mezclar([...ids, ...ids]).forEach((id) => {
            const card = document.createElement("div")
            card.className = "card"
            card.dataset.id = String(id)
            card.addEventListener("click", () => flipCard(card))
            board.appendChild(card)
        })

        board.hidden = false
        lock = false
        return true
    }

    function flipCard(card: HTMLElement) {
        if (lock || card.classList.contains("flipped")) return

        card.classList.add("flipped")
        card.style.backgroundImage = `url(${sprites.get(Number(card.dataset.id))})`

        if (!firstCard) {
            firstCard = card
            return
        }

        const first = firstCard
        firstCard = null

        if (first.dataset.id === card.dataset.id) {
            first.classList.add("matched")
            card.classList.add("matched")
            matchedPairs++

            if (matchedPairs === totalPairs) {
                clearInterval(intervalId)
                if (result) result.textContent = "¡Has ganado!"
                window.dispatchEvent(new CustomEvent("game-won", {
                    detail: { seconds, cards: totalPairs * 2 },
                }))
            }
        } else {
            lock = true
            setTimeout(() => {
                first.classList.remove("flipped")
                card.classList.remove("flipped")
                first.style.backgroundImage = ""
                card.style.backgroundImage = ""
                lock = false
            }, 800)
        }
    }

    async function startGame(n: number) {
        if (playBtn) playBtn.textContent = "Volver a jugar"
        clearInterval(intervalId)
        const ok = await buildBoard(n)
        if (ok) startTimer()
    }

    form?.addEventListener("submit", (event) => {
        event.preventDefault()

        const valor = input?.value.trim() ?? ""
        const numero = Number(valor)

        if (valor !== "" && Number.isInteger(numero) && numero > 0 && numero % 2 === 0 && numero <= MAX_POKEMON * 2) {
            startGame(numero)
        } else {
            showError(`Introduce un número entero, positivo y par (máximo ${MAX_POKEMON * 2})`)
        }
    })

    modalClose?.addEventListener("click", () => modal?.close())

    logoutBtn?.addEventListener("click", () => {
        sessionStorage.removeItem("user")
        location.reload()
    })
</script>

<style is:global>
    #game {
        max-width: 1250px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 350px;
        gap: 25px;
        align-items: start;
    }

    #game .left {
        background: white;
        padding: 30px;
        border: 4px solid #31558c;
        border-radius: 25px;
        box-shadow: 0 8px 0 #31558c;
        min-width: 0;
    }

    #game h1 {
        text-align: center;
        font-size: clamp(25px, 4vw, 36px);
        color: #e63946;
        font-weight: 900;
        margin-top: 0;
        text-shadow: 2px 2px #ffd9a6;
    }

    #game-form {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: #eef7ff;
        border-radius: 18px;
        padding: 20px;
        font-weight: 900;
    }

    #cards-number {
        width: 90px;
        padding: 12px;
        border: 2px solid #9bb9d8;
        border-radius: 10px;
        font-size: 17px;
        text-align: center;
        outline: none;
    }

    #cards-number:focus {
        border-color: #f5c518;
    }

    #play-btn {
        background: #f5c518;
        color: #26344a;
        padding: 13px 24px;
        border-radius: 12px;
        font-size: 16px;
        box-shadow: 0 5px 0 #c59c00;
    }

    #play-btn:active {
        transform: translateY(4px);
        box-shadow: 0 1px 0 #c59c00;
    }

    #timer {
        text-align: center;
        font-size: 23px;
        font-weight: 900;
        color: #31558c;
        margin: 25px 0 10px;
    }

    #timer::before {
        content: "⏱️ ";
    }

    #result {
        text-align: center;
        font-size: 25px;
        font-weight: 900;
        color: #27a65b;
    }

    #game-board {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(75px, 1fr));
        gap: 12px;
        margin-top: 25px;
        padding: 20px;
        background: #e8f5ff;
        border-radius: 20px;
        border: 3px dashed #a8c9e8;
    }

    .card {
        width: 100%;
        aspect-ratio: 3 / 4;
        min-height: 85px;
        max-height: 125px;
        border-radius: 14px;
        border: 3px solid #31558c;
        cursor: pointer;

        background-color: #e63946;
        background-image:
            linear-gradient(
                to bottom,
                transparent 46%,
                #26344a 46%,
                #26344a 54%,
                transparent 54%
            ),
            radial-gradient(
                circle at center,
                white 0 9px,
                #26344a 10px 12px,
                transparent 13px
            );

        background-repeat: no-repeat;
        background-position: center;
        background-size: 100% 100%;

        box-shadow: 0 4px 0 #26344a;
        transition: transform 0.2s, background-color 0.2s;
    }

    .card:hover {
        transform: translateY(-5px) rotate(-2deg);
    }

    .card.flipped {
        background-color: white;
        background-image: none;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }

    .card.matched {
        background-color: #c8f7d5;
        border-color: #27a65b;
        box-shadow: 0 4px 0 #188044;
        cursor: default;
        opacity: 0.85;
    }

    #modal {
        border: 4px solid #31558c;
        border-radius: 20px;
        padding: 30px;
        max-width: 400px;
        width: calc(100% - 40px);
        text-align: center;
        box-shadow: 0 8px 0 #31558c;
    }

    #modal::backdrop {
        background: #152b4b99;
        backdrop-filter: blur(4px);
    }

    #modal-text {
        font-size: 18px;
        font-weight: 800;
    }

    #modal-close {
        padding: 12px 25px;
        border-radius: 10px;
        background: #e63946;
        color: white;
        font-size: 15px;
    }

    #logout-btn {
        grid-column: 1 / -1;
        justify-self: end;
        background: #e63946;
        color: white;
        padding: 13px 25px;
        border-radius: 12px;
        box-shadow: 0 5px 0 #a8202b;
    }

    @media (max-width: 850px) {
        #game {
            grid-template-columns: 1fr;
        }

        #game .left {
            padding: 20px;
        }

        #logout-btn {
            grid-column: 1;
        }
    }

    @media (max-width: 480px) {
        body {
            padding: 15px 10px;
        }

        #game-board {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 8px;
            padding: 12px;
        }

        .card {
            min-height: 75px;
        }

        #game-form {
            flex-direction: column;
        }
    }
</style>